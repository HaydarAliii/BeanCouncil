# Copy this file as .env.prod and fill in real values.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_DB=llmcouncil
POSTGRES_USER=llmcouncil
POSTGRES_PASSWORD=                          # use a strong password (don't use the dev default)

# --- App encryption key (for encrypting the user's OpenRouter/Tavily keys in the DB) ---
# To generate: openssl rand -base64 32   (secret)   /   openssl rand -hex 16   (salt)
APP_CRYPTO_SECRET=
APP_CRYPTO_SALT=

# --- Site access password (nginx Basic Auth) — required since the app is internet-facing ---
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# --- (optional) which port to serve from on the server, default 80 ---
# APP_PORT=8080

# --- (optional) local models via Ollama ---
# Two ways to run Ollama in prod — pick one:
#
# 1. On the host (default, no extra compose file). Install Ollama on the host server
#    itself (not in a container) and pull models there (e.g. `ollama pull llama3.1`).
#    The backend reaches it via host.docker.internal automatically. Only set
#    OLLAMA_BASE_URL below if Ollama listens on a non-default host/port.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# 2. As a sidecar container (add -f docker-compose.ollama.yml to the `up` command).
#    Requires a GPU host with nvidia-container-toolkit. The sidecar sets
#    OLLAMA_BASE_URL itself — don't set it above in this mode. Instead, list which
#    models to auto-pull on first boot (comma-separated):
# OLLAMA_PULL_MODELS=llama3.1,qwen2.5
