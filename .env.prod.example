# Bu dosyayı .env.prod olarak kopyala ve gerçek değerlerini gir.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_DB=llmcouncil
POSTGRES_USER=llmcouncil
POSTGRES_PASSWORD=                          # güçlü bir şifre gir (dev'deki varsayılanı kullanma)

# --- Uygulama şifreleme anahtarı (kullanıcının OpenRouter/Tavily key'lerini DB'de şifrelemek için) ---
# Üretmek için: openssl rand -base64 32   (secret)   /   openssl rand -hex 16   (salt)
APP_CRYPTO_SECRET=
APP_CRYPTO_SALT=

# --- Siteye erişim şifresi (nginx Basic Auth) — uygulama internete açık olacağı için zorunlu ---
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# --- (opsiyonel) sunucuda hangi porttan yayınlanacağı, varsayılan 80 ---
# APP_PORT=8080
