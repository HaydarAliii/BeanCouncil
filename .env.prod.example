# Copy this file as .env.prod and fill in real values.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ---
POSTGRES_DB=llmcouncil
POSTGRES_USER=llmcouncil
POSTGRES_PASSWORD=                          # use a strong password (don't use the dev default)

# --- App encryption key (for encrypting the user's OpenRouter/Tavily keys in the DB) ---
# To generate: openssl rand -base64 32   (secret)   /   openssl rand -hex 16   (salt)
APP_CRYPTO_SECRET=
APP_CRYPTO_SALT=

# --- Site access password (nginx Basic Auth) — required since the app is internet-facing ---
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=

# --- (optional) which port to serve from on the server, default 80 ---
# APP_PORT=8080
