# Bu dosyayı .env olarak kopyala ve gerçek değerlerini gir. .env asla commit edilmez (.gitignore).

# --- Uygulama şifreleme anahtarı (kullanıcının OpenRouter key'ini DB'de şifrelemek için) ---
# Üretmek için: openssl rand -base64 32   (secret)   /   openssl rand -hex 16   (salt)
APP_CRYPTO_SECRET=
APP_CRYPTO_SALT=

# --- PostgreSQL (docker-compose ve Spring Boot datasource tarafından ortak kullanılır) ---
POSTGRES_DB=llmcouncil
POSTGRES_USER=llmcouncil
POSTGRES_PASSWORD=llmcouncil
