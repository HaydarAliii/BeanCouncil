# Copy this file as .env and fill in real values. .env is never committed (.gitignore).

# --- App encryption key (for encrypting the user's OpenRouter key in the DB) ---
# To generate: openssl rand -base64 32   (secret)   /   openssl rand -hex 16   (salt)
APP_CRYPTO_SECRET=
APP_CRYPTO_SALT=

# --- PostgreSQL (shared by docker-compose and the Spring Boot datasource) ---
POSTGRES_DB=llmcouncil
POSTGRES_USER=llmcouncil
POSTGRES_PASSWORD=llmcouncil
